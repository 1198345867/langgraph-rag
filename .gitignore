# 环境与密钥
.env
.venv/

# 依赖包与下载缓存
node_modules/
frontend/dist/
frontend/.npm-cache/
.uv-cache/
.uv-python/

# Python 字节码与测试、静态检查缓存
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# 运行时数据：上传的 PDF、MinerU 解析产物、临时目录
data/

# 运行日志
*.log

# 生成产物与可能包含问答原文的评测文件，默认不上传
*.docx
.docx-render-qa/
badcases.md

# 仅上传已脱敏的制度 PDF，其余 PDF 仍默认忽略
*.pdf
!管理制度集/*.pdf

# 本地 GitHub 辅助目录
.gh-cli/
.gh-ssh/
