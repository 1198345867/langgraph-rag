APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_CORS_ORIGINS=http://localhost:5173

ES_URL=http://127.0.0.1:9200
ES_USERNAME=
ES_PASSWORD=
ES_DOCUMENTS_INDEX=rag_documents
ES_SECTIONS_INDEX=rag_sections
ES_CHUNKS_INDEX=rag_chunks
ES_CONVERSATIONS_INDEX=rag_conversations
ES_TURNS_INDEX=rag_turns
ES_USE_IK=false

AGICTO_BASE_URL=https://api.agicto.cn/v1
AGICTO_API_KEY=
AGICTO_CHAT_MODEL=
AGICTO_FAST_MODEL=
AGICTO_EMBEDDING_MODEL=
AGICTO_RERANK_MODEL=
AGICTO_EMBEDDING_DIMENSIONS=1024
AGICTO_TIMEOUT_SECONDS=90

MINERU_COMMAND=mineru
MINERU_API_KEY=
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_MODEL_VERSION=vlm
MINERU_POLL_INTERVAL_SECONDS=2
MINERU_POLL_TIMEOUT_SECONDS=600
MINERU_OUTPUT_DIR=data/mineru
DATA_DIR=data
UPLOAD_DIR=data/uploads

CHUNK_TARGET_CHARS=500
CHUNK_MAX_SECTION_CHARS=1000
CHUNK_OVERLAP_RATIO=0.15
RETRIEVAL_CANDIDATES=30
RERANK_TOP_K=8
MIN_EVIDENCE_SCORE=0.25

MEMORY_RECENT_MESSAGES=12
MEMORY_CONTEXT_MAX_CHARS=6000
MEMORY_SUMMARY_TRIGGER_MESSAGES=12
MEMORY_SUMMARY_WINDOW_MESSAGES=24
MEMORY_SUMMARY_MAX_CHARS=1200
